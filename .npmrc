# @polinom-io packages are published to and installed from GitHub Packages (spec §2.2, v0.40–v0.42).
@polinom-io:registry=https://npm.pkg.github.com

# GitHub Packages needs a token to install, even for public packages.
# Locally: export NODE_AUTH_TOKEN=<a GitHub token with read:packages> (write:packages to publish).
# In GitHub Actions: actions/setup-node sets it from secrets.GITHUB_TOKEN. Never put a token in this file.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Refuse to install on a Node version outside package.json "engines" (see .nvmrc).
engine-strict=true

# Record exact versions, so every machine and CI resolves the same dependencies.
save-exact=true
