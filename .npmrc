# @polinom-io packages are published to and installed from GitHub Packages (spec §2.2).
@polinom-io:registry=https://npm.pkg.github.com

# No token here. pnpm 12 ignores credentials in a repository's own .npmrc, and a token must never be
# committed anyway. GitHub Packages needs one to install, even for public packages:
#   locally: add  //npm.pkg.github.com/:_authToken=<token with read:packages>  to ~/.npmrc
#   CI:      actions/setup-node with registry-url writes it from secrets.GITHUB_TOKEN

# Refuse to install on a Node version outside package.json "engines" (see .nvmrc).
engine-strict=true

# Record exact versions, so every machine and CI resolves the same dependencies.
save-exact=true
